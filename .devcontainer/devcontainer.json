{
  "name": "inventra",
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  "runArgs": [
    "--name",
    "inventra"
  ],
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    // For building and running the app's Docker image against the host's Docker
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/dobermanch/devcontainer-features/vscode-base:1": {},
    "ghcr.io/dobermanch/devcontainer-features/host-ssh:1": {},
    "ghcr.io/dobermanch/devcontainer-features/host-claude:1": {},
    "ghcr.io/dobermanch/devcontainer-features/idle-shutdown:1": {}
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "App (Express + Vite)",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install",
  "remoteEnv": {
    "APP_URL": "${localEnv:APP_URL}"
  },
  "customizations": {
    "vscode": {
      // Added to vscode-base's list
      "extensions": [
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "qwtel.sqlite-viewer",
        "dsznajder.es7-react-js-snippets",
        "christian-kohler.path-intellisense",
        "formulahendry.auto-rename-tag"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.preferences.importModuleSpecifier": "relative",
        "tailwindCSS.experimental.classRegex": [
          ["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
          ["tw`([^`]*)`"]
        ]
      }
    }
  },
  // Stop on last window close; idle-shutdown stops it after 30 idle minutes
  "shutdownAction": "stopContainer",
  "remoteUser": "vscode"
}
